rules_version = '2';

// Photos are publicly readable so <img> tags can render them directly
// (browsers can't attach auth headers to image requests). Filenames are
// unguessable tokens, and the index of all photo URLs lives in the
// auth-gated Firestore entries collection, so listing is impractical.
//
// Writes require an authenticated session, cap file size at 10MB, and
// restrict content-type to images to prevent the bucket being used as
// a free CDN for arbitrary files. Deletes are disabled (the app
// never deletes photos).
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
  }
}
