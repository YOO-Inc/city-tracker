rules_version = '2';

// Authenticated-only access for the entries collection.
// The app signs in anonymously on startup (see src/lib/firebase.ts), so any
// real app user has a valid token. Bots/scrapers without a token are
// rejected. To raise the bar further later, add Firebase App Check.
service cloud.firestore {
  match /databases/{database}/documents {
    match /entries/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
